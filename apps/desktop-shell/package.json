  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "electron": "^41.2.1",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.0"
