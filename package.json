{
  "name": "macrobay",
  "productName": "MacroBay",
  "private": true,
  "version": "0.3.1",
  "description": "Local-first AI desktop workspace for traceable market intelligence.",
  "author": "MacroBay contributors",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "generate:products": "tsx scripts/generate-product-registry.mts",
    "predev": "pnpm generate:products && pnpm generate:agent-capabilities",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "prebuild": "pnpm generate:products && pnpm generate:agent-capabilities",
    "build": "pnpm --filter @macrobay/desktop-shell build",
    "dist:mac": "pnpm build && pnpm build:info darwin arm64 && electron-builder --mac --arm64",
    "dist:mac:dir": "pnpm build && pnpm build:info darwin arm64 && electron-builder --mac --arm64 --dir",
    "dist:win": "pnpm build && pnpm build:info win32 x64 && electron-builder --win --x64",
    "dist:win:dir": "pnpm build && pnpm build:info win32 x64 && electron-builder --win --x64 --dir",
    "pretest": "pnpm generate:products && pnpm generate:agent-capabilities",
    "test": "pnpm --filter @macrobay/desktop-shell test",
    "pretypecheck": "pnpm generate:products && pnpm generate:agent-capabilities",
    "lint": "pnpm --filter @macrobay/desktop-shell lint",
    "docs:check": "node scripts/check-docs.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:danger-color": "tsx scripts/check-danger-color.mts",
    "check:boot-page": "tsx scripts/boot-failure-layout.mts",
    "build:info": "tsx scripts/release/write-build-info.mts",
    "verify:preflight": "tsx scripts/verify-preflight.mts",
    "verify": "pnpm verify:preflight && pnpm docs:check && pnpm check:file-size && pnpm check:danger-color && pnpm check:hex-color && pnpm check:undefined-token && pnpm check:components-ownership && pnpm check:async-initial-state && pnpm check:state-content-ternary && pnpm typecheck && pnpm test && pnpm build && pnpm verify:postflight",
    "verify:sole": "tsx scripts/verify-preflight.mts --strict && pnpm docs:check && pnpm check:file-size && pnpm check:danger-color && pnpm check:hex-color && pnpm check:undefined-token && pnpm check:components-ownership && pnpm check:async-initial-state && pnpm check:state-content-ternary && pnpm typecheck && pnpm test && pnpm build && pnpm verify:postflight",
    "demo:verify": "tsx scripts/demo/verify-sample.mts",
    "release:bump": "tsx scripts/release/bump-version.mts",
    "channel:acceptance": "tsx scripts/channel-acceptance.mts",
    "typecheck": "pnpm --filter @macrobay/desktop-shell typecheck",
    "generate:agent-capabilities": "tsx scripts/generate-agent-capability-reference.mts",
    "check:hex-color": "tsx scripts/check-hex-color.mts",
    "check:undefined-token": "tsx scripts/check-undefined-token.mts",
    "seed:briefing-history": "tsx scripts/seed-daily-briefing-history.mts",
    "check:async-initial-state": "tsx scripts/check-async-initial-state.mts",
    "check:state-content-ternary": "tsx scripts/check-state-content-ternary.mts",
    "check:components-ownership": "tsx scripts/check-components-ownership.mts",
    "verify:postflight": "tsx scripts/verify-postflight.mts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "products/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "electron": "^41.9.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.10.6",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "grammy": "^1.44.0",
    "html-to-image": "^1.11.13",
    "node-ical": "0.27.1",
    "proxy-agent": "^8.0.2",
    "telegram-markdown-v2": "^0.0.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
