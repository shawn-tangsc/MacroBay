#!/usr/bin/env node
/**
 * Generates the agent-facing tool reference from the capability catalog.
 *
 * The catalog is the single source of truth; this file only renders it. Run it after changing the
 * catalog (the build and test scripts do it automatically) instead of editing reference.md.
 */
import { readFile, writeFile } from 'node:fs/promises'
import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

import type { IntelligenceAgentCapability } from '../products/market-intelligence/service/intelligence/agent-capabilities/capabilityTypes'
import { intelligenceAgentCapabilities } from '../products/market-intelligence/service/intelligence/agent-capabilities/capabilityCatalog'

const workspaceRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const outputPath = resolve(
  workspaceRoot,
  'products/market-intelligence/agents/skills/intelligence-ops/reference.md'
)

const domainOrder = ['query', 'source-config', 'calendar', 'translation', 'cross-asset', 'operations'] as const
const domainTitles: Record<string, string> = {
  query: '查询与证据',
  'source-config': '情报源配置',
  calendar: '宏观日历',
  translation: '翻译',
  'cross-asset': '跨资产',
  operations: '诊断与发现'
}

function readSchemaField(schema: unknown, field: string): unknown {
  if (!schema || typeof schema !== 'object') return undefined
  return (schema as Record<string, unknown>)[field]
}

function requiredFields(capability: IntelligenceAgentCapability): string[] {
  const required = readSchemaField(capability.inputSchema, 'required')
  return Array.isArray(required) ? required.filter((item): item is string => typeof item === 'string') : []
}

function actionsOf(capability: IntelligenceAgentCapability): string[] {
  const properties = readSchemaField(capability.inputSchema, 'properties')
  if (!properties || typeof properties !== 'object') return []
  const action = (properties as Record<string, unknown>).action
  if (!action || typeof action !== 'object') return []
  const values = (action as Record<string, unknown>).enum
  return Array.isArray(values) ? values.filter((item): item is string => typeof item === 'string') : []
}

function renderLine(capability: IntelligenceAgentCapability): string {
  const required = requiredFields(capability)
  const actions = actionsOf(capability)
  const parts = [`- \`${capability.id}\`（${capability.kind}）`]
  if (required.length > 0) parts.push(`必填：${required.join('、')}`)
  else parts.push('无必填参数')
  if (actions.length > 0) parts.push(`动作：${actions.join(' / ')}`)
  parts.push(capability.description.replace(/\s+/g, ' ').trim())
  return parts.join('；')
}

function renderReference(capabilities: readonly IntelligenceAgentCapability[]): string {
  const lines: string[] = [
    '# 工具参考（自动生成）',
    '',
    '<!-- generated by scripts/generate-agent-capability-reference.mts — do not edit -->',
    '',
    `共 ${capabilities.length} 个工具：只读 ${capabilities.filter((item) => item.kind === 'read').length} 个，` +
      `写入 ${capabilities.filter((item) => item.kind === 'write').length} 个，` +
      `发现 ${capabilities.filter((item) => item.kind === 'discovery').length} 个，` +
      `交接 ${capabilities.filter((item) => item.kind === 'handoff').length} 个。`,
    '',
    '读操作自动执行；写操作每次弹确认；凭据永远不经过对话。'
  ]

  for (const domain of domainOrder) {
    const entries = capabilities.filter((item) => item.domain === domain)
    if (entries.length === 0) continue
    lines.push('', `## ${domainTitles[domain] ?? domain}`, '')
    for (const entry of entries) lines.push(renderLine(entry))
  }

  const known = new Set<string>(domainOrder)
  const ungrouped = capabilities.filter((item) => !known.has(item.domain))
  if (ungrouped.length > 0) {
    lines.push('', '## 其他', '')
    for (const entry of ungrouped) lines.push(renderLine(entry))
  }

  return `${lines.join('\n')}\n`
}

async function main(): Promise<void> {
  const next = renderReference(intelligenceAgentCapabilities as unknown as readonly IntelligenceAgentCapability[])
  let current = ''
  try {
    current = await readFile(outputPath, 'utf8')
  } catch {
    // A missing reference file is the normal first run.
  }

  if (current === next) {
    console.log(`agent capability reference is up to date (${intelligenceAgentCapabilities.length} tools)`)
    return
  }

  await writeFile(outputPath, next, 'utf8')
  console.log(`agent capability reference written (${intelligenceAgentCapabilities.length} tools)`)
}

void main().catch((error: unknown) => {
  console.error(error)
  process.exit(1)
})
