# ===========================================================================
# MacroBay 观潮 workspace ignore policy
#
# Commit:  source, docs, manifests, configs, intentional fixtures and assets.
# Never:   dependencies, build output, generated registries, local data,
#          logs, screenshots, secrets, and agent/tool scratch space.
#
# Local-only working areas (kept on disk, never committed):
#   .scratch/            ad-hoc probes, dumps, and screenshots from investigations
#   output/              Playwright / end-to-end run artifacts
#   outputs/             generated reports, workbooks, and preview images
#   products/generated/  product registry generated by `pnpm generate:products`
#
# See CONTRIBUTING.md for the public repository layout.
# ===========================================================================

# --- Secrets and environment ----------------------------------------------
.env
.env.*
*.pem
*.key
*.cert
*.p12
*.pfx
*.jks
*.keystore
electron-builder.env
*.secret

# --- Dependencies ---------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.pnpm/
.npm/
.yarn/
.yarn-cache/

# --- Build output ---------------------------------------------------------
# Root-anchored: `scripts/build/` and `scripts/release/` are source folders.
/out/
/dist/
/build/
/release/
/releases/
*.tsbuildinfo
.vite/
.turbo/
.eslintcache
*.asar
*.blockmap
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap
*.msi
*.pkg
apps/*/out/
apps/*/dist/
apps/*/build/

# --- Generated product registry -------------------------------------------
# Generated by `pnpm generate:products`; never edited or committed by hand.
products/generated/

# --- Local runtime data ---------------------------------------------------
/data/
/cache/
/tmp/
/temp/
.cache/
products/*/data/**
!products/*/data/
!products/*/data/*/
!products/*/data/README.md
!products/*/data/**/.gitkeep

# --- Databases and analytical files --------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal
*.duckdb
*.duckdb.wal
*.parquet
*.arrow
*.feather
*.csv
*.tsv
# Hand-written fixture inputs stay committed; captured data does not.
!**/fixtures/**/*.csv
!**/fixtures/**/*.tsv

# --- Local scratch and generated deliverables ----------------------------
.scratch/
scratch/
/tmp-inspect/
output/
outputs/

# --- Logs and diagnostics -------------------------------------------------
*.log
logs/
crash-reports/
diagnostics/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test and browser automation artifacts -------------------------------
.playwright-cli/
playwright-report/
test-results/
blob-report/
coverage/
*.lcov
/screenshots/
/videos/

# --- Local AI runtime state ----------------------------------------------
.models/
.ollama/
.openai/
.langchain/
vector-store/
embeddings/
# Skills are symlinked into session workspaces at runtime.
.claude/skills/
.claude/settings.local.json

# --- Python ---------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.tox/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# --- Editors and operating system ----------------------------------------
.DS_Store
.AppleDouble
.LSOverride
# Root-only macOS custom-icon file; keep unanchored patterns away from `icons/`.
/Icon?
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.history/
*.swp
*.swo
*~
*.orig
*.rej

# --- Intentional placeholders --------------------------------------------
!**/.gitkeep

# 本地验收截图（不入库）
.artifacts/

# --- Private development knowledge base -----------------------------------
# Development plans, product designs, acceptance notes, competitor analysis,
# and AI handoff documents stay local. Never publish or commit this tree.
/docs-private/

# Local AI development instructions; not part of the public repository.
/AGENTS.md
